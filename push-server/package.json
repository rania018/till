{
  "name": "till-push-server",
  "private": true,
  "description": "Cloudflare Worker: sends the weekly reminder and bill notifications as Web Push while the app is closed.",
  "type": "commonjs",
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \"lib/**/*.test.js\"",
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^22.0.0",
    "http_ece": "^1.2.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
