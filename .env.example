# Copy this file to .env.local and fill in your own values. .env.local is never committed.
# Every value below is public by design (it ships inside the built app); none is a secret.
# Leave them all out and Till still works fully on one device: sync and closed-app reminders are simply hidden.
# See docs/SELF-HOSTING.md.

# --- Sync with Google sign-in (all three are needed; with fewer, sync stays off) ---
# Firebase console > Project settings > Your apps > Web app > Config.
VITE_FIREBASE_API_KEY=AIza...your-web-api-key
# The project id. `pnpm sync:deploy` and the hosting deploy refuse to run if the Firebase CLI points at another project.
VITE_FIREBASE_PROJECT_ID=my-till
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Optional: the addresses your site is served from, comma separated, web.app first.
# Default: <project id>.web.app,<project id>.firebaseapp.com. Do not add localhost in production.
# VITE_FIREBASE_SITES=my-till.web.app,my-till.firebaseapp.com

# --- Reminders while the app is closed (both are needed; the address must be https) ---
# `pnpm push:deploy` writes these two for you.
# VITE_PUSH_API=https://my-push.example.workers.dev
# VITE_VAPID_PUBLIC_KEY=B...public-half-of-the-key-pair

# --- Local checks only ---
# Uses a made-up project and the local Firebase emulators; no other Firebase value is needed.
# VITE_FIREBASE_EMULATOR=1
