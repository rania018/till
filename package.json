{
  "name": "till",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "description": "What’s left till payday: a personal budget app that works offline.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sync": "firebase emulators:exec --only auth,firestore --project demo-till \"node scripts/test-sync.mjs\"",
    "preview": "vite preview",
    "deploy:web": "firebase deploy --only hosting",
    "sync:deploy": "node scripts/deploy-sync.mjs",
    "test:push": "npm --prefix push-server test",
    "push:deploy": "node scripts/deploy-push-server.mjs",
    "push:dev": "npm --prefix push-server run dev"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.2.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "workbox-window": "^7.4.1",
    "write-excel-file": "^4.1.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
